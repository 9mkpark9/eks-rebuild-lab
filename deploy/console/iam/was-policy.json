{
  "Version": "2012-10-17",
  "Statement": [
    { "Sid": "ReadWasArtifacts", "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::vet01-artifacts-ACCOUNT_ID/was/*" },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": [
        "arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:vet01/db/app-*",
        "arn:aws:secretsmanager:ap-northeast-2:ACCOUNT_ID:secret:vet01/redis/auth-*"
      ]
    }
  ]
}
