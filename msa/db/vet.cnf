# 보듬 동물병원 예약 DB — 컨테이너용 설정
[mysqld]
character-set-server = utf8mb4
collation-server     = utf8mb4_0900_ai_ci

# 기본값과 같지만 숫자를 드러내 둔다.
# 서비스 3개 x 복제본 수 x DB_POOL_MAX 가 이 값보다 작아야 한다 (docs-msa/결정기록.md).
max_connections = 151

# 클라이언트 IP 를 이름으로 되찾지 않는다. Pod IP 는 역방향 이름이 없어 연결이 느려진다.
skip-name-resolve

# 작은 노드에서 메모리를 아낀다. 성능 통계는 이 시연에서 쓰지 않는다.
performance_schema = OFF
innodb_buffer_pool_size = 128M
