# 빌드 산출물 — 소스에서 다시 만든다
was/build/
was/.gradle/
web/node_modules/
build/
msa/**/build/
msa/.gradle/
__pycache__/
*.pyc

# web 빌드 결과 — 원본(web/site, web/app)에서 npm run build 로 다시 만든다
web/dist/

# 실행 기록 — AWS 계정 ID, 엔드포인트, 인스턴스 ID 가 들어 있다
*.log
results/
_run/

# 도구 캐시 — 로컬 경로가 들어 있다
.impeccable/
web/.impeccable/

# 비밀 값
.env
.env.*
!.env.example
