# docker compose 가 읽는 값. 이 파일을 .env 로 복사해 비밀번호를 채운다 (.env 는 커밋하지 않는다).
# scripts\new-env.ps1 을 실행하면 비밀번호를 무작위로 채운 .env 를 만들어 준다.

# 이미지 태그 = 화면과 /status 에 보이는 버전
VERSION=1.0.0

# 웹 서버: apache (기본) 또는 nginx
WEB_SERVER=apache

# 브라우저로 여는 포트 (http://localhost:8088)
WEB_PORT=8088

# 서비스 하나가 여는 DB 연결 수
DB_POOL_MAX=5

# 비밀번호 — 영문과 숫자만 쓴다 (값을 채우지 않으면 compose 가 시작하지 않는다)
# DB 는 서비스마다 계정이 다르다: vet_auth, vet_clinic, vet_reservation
DB_ROOT_PASSWORD=
DB_AUTH_PASSWORD=
DB_CLINIC_PASSWORD=
DB_RESERVATION_PASSWORD=
REDIS_PASSWORD=
